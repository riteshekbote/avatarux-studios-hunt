          (function () {
    if (!localStorage.getItem('rc-referrer')) {
        const referrer = document.referrer;
        let referrerValue = 'direct';

        if (referrer && referrer.trim() !== '') {
            try {
                const referrerDomain = new URL(referrer).hostname;
                // Only update if we have a valid, non-empty domain that's different from ours
                if (referrerDomain &&
                    referrerDomain.trim() !== '' &&
                    referrerDomain !== window.location.hostname) {
                    referrerValue = referrerDomain;
                }
            } catch (error) {
                console.log('Referrer parsing error:', error);
            }
        }

        localStorage.setItem('rc-referrer', referrerValue);
        localStorage.setItem('rc-first-visit-on', new Date().toISOString());
    }
})();
(function () {
    // Function to send tracking data
    function sendTrackingData(userId) {
        // Check if already posted
        if (localStorage.getItem('rc-cable-post-on')) {
            console.info('🔦 Tracking data already sent, skipping');
            return;
        }

        console.info('🔦 Pulse RC down the cable')
        fetch('https://cable.' + window.location.hostname.replace(/^www./, '') + '/cable/user-event', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                userId: userId,
                registeredOn: new Date().toISOString(),
                firstVisitOn: localStorage.getItem('rc-first-visit-on'),
                referrer: localStorage.getItem('rc-referrer')
            })
        }).catch(function (error) {
            console.error('Failed to send tracking data:', error);
        });

        localStorage.setItem('rc-cable-post-on', new Date().toISOString());
    }

    window.addEventListener("message", (event) => {
        if (event.origin && event.data && event.data.type) {
            var data = { ...event.data, event: event.data.type };
            if (event.data.type == "LOGIN") {
                //do something
            } else if (event.data.type == "REGISTER") {
                sendTrackingData(localStorage.getItem('userId'))
            } else if (event.data.type == "DEPOSIT") {
                //do something
            } else if (event.data.type == "WITHDRAW_REQUESTED") {
                //do something
            } else if (event.data.type == "WITHDRAW_APPROVED") {
                //do something
            }
        }
    }, false);
})();
